# Copy this file to .env and fill in MONOBANK_TOKEN. Never commit .env.

# Personal Monobank token: open https://api.monobank.ua/, sign in with the Monobank app,
# activate "Токен фізичної особи та ФОП" and copy it right away (it is shown once).
MONOBANK_TOKEN=

# Optional (defaults shown). Relative paths are relative to the project folder.
# DATA_DIR=data
# HTTP_TIMEOUT_S=30
# RETRY_ATTEMPTS=3
# RETRY_BACKOFF_S=2
# Where the store encryption key lives: auto | keyring | file
# KEY_STORAGE=auto
